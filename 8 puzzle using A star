
# 8 Puzzle Problem using A* Search Algorithm
# 0 represents the blank space

import heapq

# Initial State
start = [
    [1, 2, 3],
    [4, 0, 6],
    [7, 5, 8]
]

# Goal State
goal = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 0]
]

# Heuristic Function (Manhattan Distance)
def heuristic(state):

    distance = 0

    for i in range(3):
        for j in range(3):

            value = state[i][j]

            if value != 0:
                x = (value - 1) // 3
                y = (value - 1) % 3

                distance += abs(i - x) + abs(j - y)

    return distance


# Find possible movements
def get_neighbors(state):

    neighbors = []

    for i in range(3):
        for j in range(3):
            if state[i][j] == 0:
                x, y = i, j

    moves = [
        (-1, 0, "Up"),
        (1, 0, "Down"),
        (0, -1, "Left"),
        (0, 1, "Right")
    ]

    for dx, dy, move in moves:

        nx = x + dx
        ny = y + dy

        if 0 <= nx < 3 and 0 <= ny < 3:

            new_state = [row[:] for row in state]

            # Swap blank space with adjacent tile
            new_state[x][y], new_state[nx][ny] = (
                new_state[nx][ny],
                new_state[x][y]
            )

            neighbors.append((new_state, move))

    return neighbors


# A* Search Algorithm
def astar(start):

    # Priority queue: (f, g, state, path)
    pq = []

    heapq.heappush(
        pq,
        (heuristic(start), 0, start, [])
    )

    visited = set()

    while pq:

        f, g, state, path = heapq.heappop(pq)

        key = tuple(map(tuple, state))

        if key in visited:
            continue

        visited.add(key)

        # Check goal state
        if state == goal:
            return path + [(state, "Goal")]

        # Generate neighboring states
        for new_state, move in get_neighbors(state):

            new_key = tuple(map(tuple, new_state))

            if new_key not in visited:

                new_g = g + 1
                new_h = heuristic(new_state)
                new_f = new_g + new_h

                heapq.heappush(
                    pq,
                    (
                        new_f,
                        new_g,
                        new_state,
                        path + [(state, move)]
                    )
                )

    return None


# Display solution
def display_solution(solution):

    if solution is None:
        print("No solution found!")
        return

    print("Solution Found!")
    print("Total Moves:", len(solution) - 1)

    for step, (state, move) in enumerate(solution):

        print("\nStep", step, "-", move)

        for row in state:
            print(row)


# Execute A* Algorithm
solution = astar(start)

display_solution(solution)
