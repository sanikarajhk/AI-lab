
def alpha_beta(node, depth, alpha, beta, maximizing):
    
    # If leaf node is reached
    if depth == 0 or isinstance(node, int):
        return node

    if maximizing:
        max_eval = float('-inf')

        for child in node:
            eval = alpha_beta(child, depth - 1,
                              alpha, beta, False)

            max_eval = max(max_eval, eval)
            alpha = max(alpha, eval)

            # Pruning condition
            if alpha >= beta:
                break

        return max_eval

    else:
        min_eval = float('inf')

        for child in node:
            eval = alpha_beta(child, depth - 1,
                              alpha, beta, True)

            min_eval = min(min_eval, eval)
            beta = min(beta, eval)

            # Pruning condition
            if alpha >= beta:
                break

        return min_eval


# Game tree
tree = [
    [[3, 5], [6, 9]],
    [[1, 2], [0, -1]]
]

# Initial values
alpha = float('-inf')
beta = float('inf')

# Find the best value
result = alpha_beta(tree, 3, alpha, beta, True)

print("Best value:", result)
