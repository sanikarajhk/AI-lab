
import random

# Number of queens
N = 8

# Calculate number of attacking pairs
def heuristic(board):
    attacks = 0

    for i in range(N):
        for j in range(i + 1, N):

            # Check diagonal attacks
            if abs(board[i] - board[j]) == abs(i - j):
                attacks += 1

    return attacks


# Hill Climbing Algorithm
def hill_climbing():

    # Random initial state
    board = [random.randint(0, N - 1) for _ in range(N)]

    while True:

        current_h = heuristic(board)

        # If no queens attack each other
        if current_h == 0:
            return board

        best_board = board[:]
        best_h = current_h

        # Generate neighboring states
        for col in range(N):

            for row in range(N):

                if row != board[col]:

                    new_board = board[:]
                    new_board[col] = row

                    new_h = heuristic(new_board)

                    if new_h < best_h:
                        best_h = new_h
                        best_board = new_board

        # If no better state is found, restart
        if best_h >= current_h:
            board = [
                random.randint(0, N - 1)
                for _ in range(N)
            ]
        else:
            board = best_board


# Display chessboard
def display_board(board):

    for row in range(N):

        for col in range(N):

            if board[col] == row:
                print(" Q ", end="")
            else:
                print(" . ", end="")

        print()


# Execute program
solution = hill_climbing()

print("Solution Found!")
print("Queen positions:", solution)

print("\nChessboard:")
display_board(solution)

print("\nAttacking pairs:", heuristic(solution))
